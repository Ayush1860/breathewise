        "additionalProperties": false,
        "properties": {
          "activity": {
            "$ref": "#/components/schemas/Activity"
          },
          "duration_h": {
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Duration H",
            "type": "integer"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "station_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Defaults to the venue station",
            "title": "Station Id"
          }
        },
        "required": [
          "profile",
          "activity",
          "duration_h"
        ],
        "title": "AdviceRequest",
        "type": "object"
      },
