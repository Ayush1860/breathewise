            "description": "q90 (cautious) for sensitive profiles",
            "enum": [
              "q50",
              "q90"
            ],
            "title": "Basis",
            "type": "string"
          },
          "best_window": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BestWindow"
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_h": {
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Duration H",
            "type": "integer"
          },
          "forecast_issued_at": {
            "format": "date-time",
            "title": "Forecast Issued At",
            "type": "string"
          },
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "reason": {
            "$ref": "#/components/schemas/Message"
          },
          "stale": {
            "title": "Stale",
            "type": "boolean"
          },
          "station_id": {
            "title": "Station Id",
            "type": "string"
          },
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          }
