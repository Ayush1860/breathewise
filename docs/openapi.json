          "aqi": {
            "anyOf": [
              {
                "maximum": 500.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aqi"
          },
          "band": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Band"
              },
              {
                "type": "null"
              }
            ]
          },
          "dominant_pollutant": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Pollutant"
