            "type": "number"
          },
          "accuracy_persistence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Accuracy Persistence",
            "type": "number"
          },
          "horizon_h": {
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Horizon H",
            "type": "integer"
          }
        },
        "required": [
          "horizon_h",
          "accuracy",
          "accuracy_persistence"
