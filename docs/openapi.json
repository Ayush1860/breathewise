      "CurrentAqiResponse": {
        "additionalProperties": false,
        "properties": {
          "age_minutes": {
            "minimum": 0.0,
            "title": "Age Minutes",
            "type": "integer"
          },
          "aqi": {
            "$ref": "#/components/schemas/AqiValue"
